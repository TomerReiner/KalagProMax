{
  "name": "GapUpdate",
  "type": "object",
  "properties": {
    "gap_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e2\u05e8",
      "description": "\u05d4\u05e4\u05e2\u05e8 \u05e9\u05d4\u05e2\u05d3\u05db\u05d5\u05df \u05e9\u05d9\u05d9\u05da \u05d0\u05dc\u05d9\u05d5"
    },
    "update_type": {
      "type": "string",
      "enum": [
        "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e1\u05d8\u05d8\u05d5\u05e1",
        "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea",
