{
  "name": "TaskCompletion",
  "type": "object",
  "properties": {
    "task_type": {
      "type": "string",
      "enum": [
        "event",
        "shotaf"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "task_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "task_field": {
      "type": "string",
      "title": "\u05e9\u05d3\u05d4 \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "task_label": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e9\u05d9\u05de\u05d4"
    },
    "task_date": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "pluga": {
      "type": "string",
      "enum": [
        "\u05e4\u05d0\u05e8\u05df",
        "\u05d1\u05e9\u05d5\u05e8",
        "\u05e6\u05d9\u05df",
        "\u05e8\u05de\u05d5\u05df",
        "\u05ea\u05de\u05e8"
      ],
      "title": "\u05e4\u05dc\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "task_type",
    "task_id",
    "task_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}