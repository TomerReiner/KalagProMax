{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-daily-tasks-push", "schedule": "0 4 * * *" },
    { "path": "/api/send-daily-tasks-push", "schedule": "0 5 * * *" }
  ]
}
